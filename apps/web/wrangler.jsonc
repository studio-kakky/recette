{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recette-web",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // TanStack Start が提供する Workers 用サーバエントリ
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
  },
  // 画像（参照用 / 作った記録）の保存先。バケット作成手順は README.md を参照
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "recette-images",
    },
  ],
  // レシピ本体のデータベース。DB 作成手順は README.md を参照
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recette-db",
      // TODO: `wrangler d1 create recette-db` の出力した UUID に差し替える（--local では未使用）
      "database_id": "00000000-0000-0000-0000-000000000000",
      // drizzle.config.ts の `out` と揃える
      "migrations_dir": "drizzle/migrations",
    },
  ],
}
